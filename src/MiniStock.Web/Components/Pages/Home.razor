@page "/"
@inject InventoryService Inventory

<PageTitle>MiniStock - Dashboard</PageTitle>

<h1>Dashboard</h1>

@if (summary is null)
{
    <p>Loading...</p>
}
else
{
    <div class="cards">
        <div class="card"><span class="card-label">Products</span><span class="card-value">@summary.ProductCount</span></div>
        <div class="card"><span class="card-label">Units in stock</span><span class="card-value">@summary.TotalUnits.ToString("N0")</span></div>
        <div class="card"><span class="card-label">Stock value</span><span class="card-value">@summary.StockValue.ToString("N2") &euro;</span></div>
        <div class="card @(summary.LowStockCount > 0 ? "card-alert" : null)"><span class="card-label">Low stock</span><span class="card-value">@summary.LowStockCount</span></div>
    </div>

    <h2>Needs reordering</h2>
    @if (summary.LowStock.Count == 0)
    {
        <p class="msg ok">Everything is above its reorder level.</p>
    }
    else
    {
        <table>
            <thead><tr><th>SKU</th><th>Product</th><th>Supplier</th><th class="num">In stock</th><th class="num">Reorder at</th></tr></thead>
            <tbody>
            @foreach (var p in summary.LowStock)
            {
                <tr class="low">
                    <td>@p.Sku</td>
                    <td>@p.Name</td>
                    <td>@(p.Supplier?.Name ?? "-")</td>
                    <td class="num">@p.Quantity</td>
                    <td class="num">@p.ReorderLevel</td>
                </tr>
            }
            </tbody>
        </table>
    }
}

@code {
    private DashboardSummary? summary;

    protected override async Task OnInitializedAsync() => summary = await Inventory.GetSummaryAsync();
}
